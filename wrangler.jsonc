// Cloudflare Workers static-assets deploy. Workers Builds runs `npm run build`, then
// `npx wrangler deploy` uploads dist/. No Worker script: the app is a static site.
{
  "name": "solarscale",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Branch builds run `npx wrangler preview`, which needs this block (it may stay empty).
  "previews": {},
}
